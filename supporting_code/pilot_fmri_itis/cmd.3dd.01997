# -------------------------------------------------------
# create 3dDeconvolve -nodata command

3dDeconvolve                                                \
    -nodata 1800 2.000                                      \
    -polort 3                                               \
    -concat '1D: 0 180 360 540 720 900 1080 1260 1440 1620' \
    -num_stimts 3                                           \
    -stim_times 1 stimes.01997_01_high_vis.1D GAM           \
    -stim_label 1 high_vis                                  \
    -stim_times 2 stimes.01997_02_low_vis.1D GAM            \
    -stim_label 2 low_vis                                   \
    -stim_times 3 stimes.01997_03_absent.1D GAM             \
    -stim_label 3 absent                                    \
    -x1D X.stimes.01997.xmat.1D

# compute the sum of non-baseline regressors
3dTstat -sum -prefix sum_ideal.1D X.stimes.01997.xmat.1D'[40..$]'

# consider plotting the SUM below non-polort regressors:
# (if(0) allows easy copy-and-paste)
if ( 0 ) then
   1dplot -sepscl -xlabel Time -ynames SUM - sum_ideal.1D \
       X.stimes.01997.xmat.1D'[40..$]'
endif

# or the more completely labeled command:
if ( 0 ) then
   1dplot -sepscl -xlabel "Time index"                    \
          -ynames SUM high_vis low_vis absent -           \
           sum_ideal.1D X.stimes.01997.xmat.1D'[40..$]'
endif


